---
import {
  ArrowLeft,
  ArrowUpRight,
  Bookmark,
  BookOpen,
  ChevronDown,
  CircleAlert,
  CircleDot,
  Clock,
  ExternalLink,
  GitFork,
  GitBranch,
  Star,
} from '@lucide/astro'

import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  formatCompactNumber,
  isOfficialRepository,
  sortCatalogEntries,
  type Catalog,
  type CatalogEntry,
} from '../../lib/catalog'
import { mergeCommunityEntries, type CommunityEntry } from '../../lib/community'
import { getCategory, getProjectTypeLabel } from '../../lib/classification'
import { getReadmeApiUrl } from '../../lib/readme'
import catalogData from '../../data/catalog.json'
import communityData from '../../data/community.json'

const catalog = mergeCommunityEntries(catalogData as Catalog, communityData as CommunityEntry[])

export function getStaticPaths() {
  const catalog = mergeCommunityEntries(catalogData as Catalog, communityData as CommunityEntry[])
  return catalog.repositories.map((repository) => ({
    params: { id: repository.slug },
    props: { repository },
  }))
}

interface Props {
  repository: CatalogEntry
}

const { repository } = Astro.props as Props
const category = getCategory(repository.category)
const related = sortCatalogEntries(
  catalog.repositories
    .filter((item) => item.repositoryId !== repository.repositoryId && item.category === repository.category),
  'stars',
).slice(0, 3)
const readmeApiUrl = getReadmeApiUrl(repository.fullName)
const createdDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date(repository.createdAt))
const submittedDate = repository.submittedAt
  ? new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).format(new Date(repository.submittedAt))
  : null
const pushedAtDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hour12: false,
}).format(new Date(repository.pushedAt))
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
const statusBadge = repository.archived
  ? { kind: 'archived', label: '已归档' }
  : repository.featured
    ? { kind: 'featured', label: '精选' }
    : null
const isOfficial = isOfficialRepository(repository.fullName)
const isCommunity = repository.source === 'community' || repository.projectType === 'community'
---

<BaseLayout title={`${repository.name} · DeepSeek Harness插件市场`} description={repository.description}>
  <section class="detail-hero">
    <div class="container">
      <a class="back-link" href={baseUrl}><ArrowLeft size={15} stroke-width={1.7} /> 返回目录</a>

      <div class="detail-hero__grid">
        <div class="detail-identity">
          <div class="detail-eyebrow">
            <span class="category-dot" style={`--category-color: ${category.color}`}></span>
            <span>{category.label}</span>
            <span class="detail-eyebrow__type" hidden={isCommunity}>{getProjectTypeLabel(repository.projectType)}</span>
            {
              isOfficial && (
                <span class="badge badge--official">官方</span>
              )
            }
            {
              isCommunity && (
                <span class="badge badge--community">社群发布</span>
              )
            }
            {
              statusBadge && (
                <span class={`badge badge--${statusBadge.kind}`}>
                  {statusBadge.kind === 'featured' && <Star size={12} stroke-width={2} />}
                  {statusBadge.kind === 'archived' && <CircleAlert size={12} stroke-width={2} />}
                  {statusBadge.label}
                </span>
              )
            }
          </div>

          <div class="detail-title">
            <img class="avatar" src={repository.owner.avatarUrl} width="48" height="48" alt="" loading="lazy" />
            <div>
              <h1>{repository.name}</h1>
              <p>{repository.fullName}</p>
            </div>
          </div>

          <p class="detail-description">{repository.description}</p>

          <div class="detail-actions">
            <a class="btn btn--primary" href={repository.url} target="_blank" rel="noreferrer">
              去 GitHub 查看
              <ArrowUpRight size={15} stroke-width={1.7} />
            </a>
            {repository.homepage && repository.homepage !== 'https://github.com/topics/dsh-plugin' && (
              <a class="btn" href={repository.homepage} target="_blank" rel="noreferrer">
                <ExternalLink size={15} stroke-width={1.7} />
                项目主页
              </a>
            )}
            <button class="btn" id="detail-fav" type="button" data-fav-id={repository.repositoryId} aria-pressed="false">
              <Bookmark size={15} stroke-width={1.7} />
              <span>收藏</span>
            </button>
          </div>
        </div>

        <aside class="repository-facts card" aria-label="仓库信息">
          <p class="mono-label">REPOSITORY FACTS</p>
          <dl>
            <div><dt>主要语言</dt><dd>{repository.language ?? '未知'}</dd></div>
            <div><dt>许可证</dt><dd>{repository.license ?? '未声明'}</dd></div>
            <div><dt>默认分支</dt><dd class="facts-mono"><GitBranch size={12} stroke-width={1.7} /> {repository.defaultBranch}</dd></div>
            <div><dt>创建时间</dt><dd>{createdDate}</dd></div>
            <div><dt>归档状态</dt><dd>{repository.archived ? '已归档' : '活跃'}</dd></div>
            {
              submittedDate && (
                <div><dt>提交时间</dt><dd>{submittedDate}</dd></div>
              )
            }
            <div><dt>数据来源</dt><dd>{isCommunity ? '社群发布' : 'GitHub Topic'}</dd></div>
          </dl>
          <p class="facts-note">
            本店只收录 GitHub 上标注 dsh-plugin Topic 的公开仓库，不下载、不执行第三方代码；
            收录不代表安装、兼容或安全背书。
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="detail-content">
    <div class="container">
      <div class="detail-main">
        <section class="detail-section">
          <p class="mono-label">OVERVIEW</p>
          <h2>数据概览</h2>
          <dl class="overview-grid">
            <div>
              <dt><Star size={14} stroke-width={1.7} /> Star</dt>
              <dd>{formatCompactNumber(repository.stars)}</dd>
            </div>
            <div>
              <dt><GitFork size={14} stroke-width={1.7} /> Fork</dt>
              <dd>{formatCompactNumber(repository.forks)}</dd>
            </div>
            <div>
              <dt><CircleDot size={14} stroke-width={1.7} /> 开放 Issue</dt>
              <dd>{formatCompactNumber(repository.openIssues)}</dd>
            </div>
            <div>
              <dt><Clock size={14} stroke-width={1.7} /> 最后推送</dt>
              <dd>{pushedAtDate}</dd>
            </div>
          </dl>
        </section>

        <section class="detail-section">
          <p class="mono-label">PROJECT TOPICS</p>
          <h2>项目标签</h2>
          <div class="topic-cloud">
            {repository.topics.map((topic) => (
              <a href={`${baseUrl}topics/${encodeURIComponent(topic)}`} aria-label={`查看包含 ${topic} 标签的所有项目`}>
                {topic}
              </a>
            ))}
          </div>
        </section>

        <section class="detail-section readme-section">
          <details
            class="readme-disclosure"
            id="readme-disclosure"
            data-readme-api={readmeApiUrl}
            data-full-name={repository.fullName}
            data-default-branch={repository.defaultBranch}
          >
            <summary>
              <span class="readme-heading">
                <span class="mono-label">PROJECT README</span>
                <span class="readme-title"><BookOpen size={19} stroke-width={1.7} /> README</span>
              </span>
              <span class="readme-toggle">
                <span class="readme-toggle__closed">展开</span>
                <span class="readme-toggle__open">收起</span>
                <ChevronDown size={16} stroke-width={1.7} />
              </span>
            </summary>
            <div class="readme-content" id="readme-content" aria-live="polite" aria-busy="false">
              <p class="readme-state" id="readme-state">正在读取 GitHub README...</p>
              <div class="markdown-body" id="readme-body" hidden></div>
              <div class="readme-error" id="readme-error" hidden>
                <p id="readme-error-message">README 暂时无法读取。</p>
                <button class="btn" id="retry-readme" type="button">重试</button>
                <a class="btn" href={repository.url} target="_blank" rel="noreferrer">前往仓库</a>
              </div>
            </div>
          </details>
        </section>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <div class="related-heading">
          <div><p class="mono-label">MORE IN CATEGORY</p><h2>同类插件</h2></div>
          <a class="btn" href={`${baseUrl}?category=${repository.category}`}>浏览分类</a>
        </div>
        <div class="related-grid">
          {related.map((item) => <ProjectCard repository={item} />)}
        </div>
      </div>
    </section>
  )}

  <script>
    import { resolveReadmeReference, type ReadmeLocation } from '../../lib/readme'

    // ---------- 收藏 ----------
    const FAVORITES_KEY = 'dsh-market:favorites'
    const detailFav = document.getElementById('detail-fav')
    if (detailFav) {
      const repositoryId = detailFav.dataset.favId!
      const readFavorites = () => {
        try {
          const raw = localStorage.getItem(FAVORITES_KEY)
          return new Set(raw ? JSON.parse(raw) : [])
        } catch {
          return new Set()
        }
      }
      const setFavState = (active: boolean) => {
        detailFav.classList.toggle('is-active', active)
        detailFav.setAttribute('aria-pressed', String(active))
        const label = detailFav.querySelector('span')
        if (label) label.textContent = active ? '已收藏' : '收藏'
      }
      setFavState(readFavorites().has(repositoryId))
      detailFav.addEventListener('click', () => {
        const favorites = readFavorites()
        const active = !favorites.has(repositoryId)
        if (active) {
          favorites.add(repositoryId)
        } else {
          favorites.delete(repositoryId)
        }
        localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favorites]))
        setFavState(active)
      })
    }

    const readmeDisclosure = document.querySelector<HTMLDetailsElement>('#readme-disclosure')!
    const readmeContent = document.querySelector<HTMLElement>('#readme-content')!
    const readmeState = document.querySelector<HTMLElement>('#readme-state')!
    const readmeBody = document.querySelector<HTMLElement>('#readme-body')!
    const readmeError = document.querySelector<HTMLElement>('#readme-error')!
    const readmeErrorMessage = document.querySelector<HTMLElement>('#readme-error-message')!
    const retryReadme = document.getElementById('retry-readme')
    let readmeLoaded = false
    let readmeLoading = false

    const showReadmeError = (message: string) => {
      readmeState.hidden = true
      readmeBody.hidden = true
      readmeErrorMessage.textContent = message
      readmeError.hidden = false
    }

    const loadReadme = async () => {
      if (readmeLoaded || readmeLoading) return
      readmeLoading = true
      readmeContent.setAttribute('aria-busy', 'true')
      readmeState.hidden = false
      readmeState.textContent = '正在读取 GitHub README...'
      readmeBody.hidden = true
      readmeError.hidden = true

      try {
        const readmeApi = readmeDisclosure.dataset.readmeApi
        if (!readmeApi) throw new Error('README 地址不可用。')
        const response = await fetch(readmeApi, {
          headers: { Accept: 'application/vnd.github.html+json' },
        })
        if (response.status === 404 || response.status === 409) {
          readmeState.textContent = '该仓库暂未提供可读取的 README。'
          readmeLoaded = true
          return
        }
        if (response.status === 403 || response.status === 429) {
          throw new Error('GitHub API 访问频率已达上限，请稍后重试。')
        }
        if (!response.ok) throw new Error('GitHub README 暂时无法读取，请稍后重试。')

        const documentFragment = new DOMParser().parseFromString(await response.text(), 'text/html')
        const wrapper = documentFragment.querySelector('#readme')
        const article = wrapper?.querySelector('article.markdown-body')
        if (!wrapper || !article) throw new Error('GitHub README response did not contain an article')

        const location: ReadmeLocation = {
          fullName: readmeDisclosure.dataset.fullName!,
          defaultBranch: readmeDisclosure.dataset.defaultBranch || 'main',
          readmePath: wrapper.getAttribute('data-path') || 'README.md',
        }
        article.querySelectorAll('a[href]').forEach((link) => {
          const href = link.getAttribute('href')
          if (!href) return
          link.setAttribute('href', resolveReadmeReference(href, location, 'link'))
          if (!href.startsWith('#')) {
            link.setAttribute('target', '_blank')
            link.setAttribute('rel', 'noreferrer')
          }
        })
        article.querySelectorAll('[src]').forEach((media) => {
          const src = media.getAttribute('src')
          if (src) media.setAttribute('src', resolveReadmeReference(src, location, 'media'))
        })

        readmeBody.replaceChildren(...Array.from(article.childNodes).map((node) => document.importNode(node, true)))
        readmeState.hidden = true
        readmeBody.hidden = false
        readmeLoaded = true
      } catch (error) {
        showReadmeError(error instanceof Error ? error.message : 'GitHub README 暂时无法读取，请稍后重试。')
      } finally {
        readmeLoading = false
        readmeContent.setAttribute('aria-busy', 'false')
      }
    }

    readmeDisclosure?.addEventListener('toggle', () => {
      if (readmeDisclosure.open) void loadReadme()
    })
    retryReadme?.addEventListener('click', () => void loadReadme())
  </script>
</BaseLayout>

<style>
  .detail-hero {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .detail-hero .container {
    padding-block: 24px 48px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 13px;
    transition: color 140ms ease;
  }

  .back-link:hover {
    color: var(--text-1);
  }

  .detail-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 64px;
    align-items: start;
    padding-top: 40px;
  }

  .detail-eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--text-2);
    font-size: 13px;
  }

  .detail-eyebrow__type {
    border-left: 1px solid var(--line);
    padding-left: 8px;
    color: var(--text-3);
  }

  .category-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--category-color);
  }

  .detail-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
  }

  .detail-title img {
    width: 48px;
    height: 48px;
  }

  .detail-title h1 {
    overflow-wrap: anywhere;
    font-size: 32px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.01em;
  }

  .detail-title p {
    margin-top: 2px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .detail-description {
    max-width: 640px;
    margin-top: 20px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 26px;
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .detail-actions .btn {
    min-height: 38px;
  }

  #detail-fav.is-active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  #detail-fav.is-active svg {
    fill: var(--accent);
    stroke: var(--accent);
  }

  /* ---------- content ---------- */

  .detail-content {
    padding-block: 48px 64px;
  }

  .detail-main {
    display: grid;
    min-width: 0;
    gap: 44px;
  }

  .detail-section {
    min-width: 0;
  }

  .detail-section h2,
  .related-heading h2 {
    margin: 8px 0 20px;
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .overview-grid div {
    padding: 16px;
  }

  .overview-grid div + div {
    border-left: 1px solid var(--line);
  }

  .overview-grid dt {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-3);
    font-size: 12px;
  }

  .overview-grid dd {
    margin: 6px 0 0;
    font-size: 17px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .topic-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-cloud a {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-2);
    font-size: 12px;
    padding-inline: 12px;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .topic-cloud a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* ---------- readme ---------- */

  .readme-disclosure {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    overflow: hidden;
  }

  .readme-disclosure summary {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    list-style: none;
    padding: 16px 20px;
  }

  .readme-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .readme-heading {
    display: grid;
    gap: 5px;
  }

  .readme-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 600;
    line-height: 26px;
  }

  .readme-title svg {
    color: var(--text-3);
  }

  .readme-toggle {
    display: inline-flex;
    min-width: 66px;
    min-height: 30px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-2);
    font-size: 12px;
    padding-inline: 10px;
    transition: border-color 140ms ease, color 140ms ease;
  }

  .readme-toggle svg {
    transition: transform 160ms ease;
  }

  .readme-toggle__open {
    display: none;
  }

  .readme-disclosure[open] .readme-toggle__closed {
    display: none;
  }

  .readme-disclosure[open] .readme-toggle__open {
    display: inline;
  }

  .readme-disclosure[open] .readme-toggle svg {
    transform: rotate(180deg);
  }

  .readme-content {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding: 24px 28px 36px;
  }

  .readme-state,
  .readme-error p {
    margin: 0;
    color: var(--text-3);
    font-size: 13px;
  }

  .readme-error {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .readme-error p {
    width: 100%;
  }

  :global(.readme-content .markdown-body) {
    min-width: 0;
    color: var(--text-1);
    font-size: 14px;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  :global(.readme-content .markdown-body > :first-child) {
    margin-top: 0;
  }

  :global(.readme-content .markdown-body > :last-child) {
    margin-bottom: 0;
  }

  :global(.readme-content .markdown-body h1),
  :global(.readme-content .markdown-body h2),
  :global(.readme-content .markdown-body h3),
  :global(.readme-content .markdown-body h4) {
    margin: 28px 0 12px;
    color: var(--text-1);
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.readme-content .markdown-body h1) {
    border-bottom: 1px solid var(--line);
    font-size: 26px;
    padding-bottom: 10px;
  }

  :global(.readme-content .markdown-body h2) {
    border-bottom: 1px solid var(--line);
    font-size: 21px;
    padding-bottom: 8px;
  }

  :global(.readme-content .markdown-body h3) {
    font-size: 17px;
  }

  :global(.readme-content .markdown-body h4) {
    font-size: 15px;
  }

  :global(.readme-content .markdown-body p),
  :global(.readme-content .markdown-body ul),
  :global(.readme-content .markdown-body ol),
  :global(.readme-content .markdown-body blockquote),
  :global(.readme-content .markdown-body pre),
  :global(.readme-content .markdown-body table),
  :global(.readme-content .markdown-body details) {
    margin: 0 0 16px;
  }

  :global(.readme-content .markdown-body ul),
  :global(.readme-content .markdown-body ol) {
    padding-left: 24px;
  }

  :global(.readme-content .markdown-body a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }

  :global(.readme-content .markdown-body a:hover) {
    text-decoration-color: currentColor;
  }

  :global(.readme-content .markdown-body blockquote) {
    border-left: 3px solid var(--line-strong);
    color: var(--text-2);
    padding-left: 14px;
  }

  :global(.readme-content .markdown-body code) {
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 2px 5px;
  }

  :global(.readme-content .markdown-body pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 14px;
  }

  :global(.readme-content .markdown-body pre code) {
    background: transparent;
    padding: 0;
  }

  :global(.readme-content .markdown-body table) {
    width: 100%;
    border-collapse: collapse;
  }

  :global(.readme-content .markdown-body th),
  :global(.readme-content .markdown-body td) {
    border: 1px solid var(--line);
    padding: 8px 10px;
    text-align: left;
  }

  :global(.readme-content .markdown-body th) {
    background: var(--bg-soft);
