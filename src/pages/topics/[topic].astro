---
import { ArrowLeft, Tag } from '@lucide/astro'

import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { sortCatalogEntries, type Catalog, type CatalogEntry } from '../../lib/catalog'
import catalogData from '../../data/catalog.json'

interface Props {
  topic: string
  repositories: CatalogEntry[]
  totalCount: number
}

/** 单个标签页最多渲染的项目数：dsh-plugin 标签有数千个项目，
 *  全量渲染会撑爆 Cloudflare Pages 25 MiB 单文件上限，且对用户不可用。 */
export function getStaticPaths() {
  const MAX_TOPIC_REPOSITORIES = 200
  const catalog = catalogData as Catalog
  const topics = [...new Set(catalog.repositories.flatMap((repository) => repository.topics))]
    .sort((left, right) => left.localeCompare(right))

  return topics.map((topic) => {
    const all = sortCatalogEntries(
      catalog.repositories.filter((repository) => repository.topics.includes(topic)),
      'rating',
    )
    return {
      params: { topic },
      props: {
        topic,
        repositories: all.slice(0, MAX_TOPIC_REPOSITORIES),
        totalCount: all.length,
      },
    }
  })
}

const { topic, repositories, totalCount } = Astro.props as Props
const isTruncated = totalCount > repositories.length
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
---

<BaseLayout
  title={`${topic} 标签 · DeepSeek Harness插件市场`}
  description={`浏览 GitHub Topic 为 ${topic} 的 DSH 生态项目。`}
>
  <section class="topic-hero">
    <div class="container">
      <a class="back-link" href={baseUrl}><ArrowLeft size={15} stroke-width={1.7} /> 返回目录</a>
      <div class="topic-hero__content">
        <div>
          <p class="mono-label">GITHUB TOPIC</p>
          <h1><Tag size={26} stroke-width={1.6} /> {topic}</h1>
        </div>
        <p><strong>{totalCount}</strong> 个项目包含此标签</p>
      </div>
    </div>
  </section>

  <section class="topic-results">
    <div class="container">
      <div class="results-head">
        <p><span id="result-count">{totalCount}</span> 个项目</p>
        <p class="results-head__note">GitHub Topic 精确匹配</p>
      </div>
      {isTruncated && (
        <p class="topic-truncate-note">
          该标签共 {totalCount} 个项目，仅展示评分最高的 {repositories.length} 个；完整列表请在首页搜索或筛选查看。
        </p>
      )}
      <div class="project-grid">
        {repositories.map((repository) => <ProjectCard repository={repository} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-hero {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .topic-hero .container {
    padding-block: 24px 40px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 13px;
    transition: color 140ms ease;
  }

  .back-link:hover {
    color: var(--text-1);
  }

  .topic-hero__content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    padding-top: 40px;
  }

  .topic-hero__content h1 {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    overflow-wrap: anywhere;
    font-size: 32px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.01em;
  }

  .topic-hero__content h1 svg {
    color: var(--text-3);
  }

  .topic-hero__content > p {
    flex: 0 0 auto;
    color: var(--text-3);
    font-size: 13px;
  }

  .topic-hero__content strong {
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
  }

  .topic-results {
    min-height: 60vh;
    padding-block: 28px 64px;
  }

  .results-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 14px;
    color: var(--text-3);
    font-size: 12px;
  }

  .topic-truncate-note {
    margin-bottom: 14px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    padding: 8px 12px;
    color: var(--text-3);
    font-size: 12px;
    line-height: 18px;
  }

  .results-head p {
    margin: 0;
  }

  .results-head__note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .topic-hero .container {
      padding-block: 20px 32px;
    }

    .topic-hero__content {
      display: grid;
      gap: 20px;
      padding-top: 32px;
    }

    .topic-hero__content h1 {
      font-size: 26px;
      line-height: 34px;
    }

    .topic-hero__content > p {
      border-top: 1px solid var(--line);
      padding-top: 14px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
