---
import {
  Bookmark,
  Boxes,
  ChevronDown,
  Crown,
  LayoutGrid,
  Layers,
  Link2,
  RefreshCw,
  Search,
  Send,
  SlidersHorizontal,
  Star,
  X,
} from '@lucide/astro'

import ProjectCard from '../components/ProjectCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { sortCatalogEntries, type Catalog } from '../lib/catalog'
import { mergeCommunityEntries, type CommunityEntry } from '../lib/community'
import { CATEGORIES, PROJECT_TYPES } from '../lib/classification'
import { CURATED_PICKS } from '../data/curated'
import catalogData from '../data/catalog.json'
import communityData from '../data/community.json'

const catalog = mergeCommunityEntries(catalogData as Catalog, communityData as CommunityEntry[])
const featuredCount = catalog.repositories.filter((repository) => repository.featured).length
const initialRepositories = sortCatalogEntries(catalog.repositories, 'created').slice(0, 24)
const generatedDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(catalog.generatedAt))
const serializedCatalog = JSON.stringify(catalog.repositories).replace(/</g, '\\u003c')
const serializedCategories = JSON.stringify(CATEGORIES).replace(/</g, '\\u003c')
const serializedTypes = JSON.stringify(PROJECT_TYPES).replace(/</g, '\\u003c')
const serializedCurated = JSON.stringify(CURATED_PICKS.map((pick) => pick.fullName)).replace(/</g, '\\u003c')
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
---

<BaseLayout>
  <section class="home-hero">
    <div class="container home-hero__inner">
      <p class="mono-label">DEEPSEEK HARNESS PLUGIN STORE</p>
      <img class="home-hero__logo" src={`${baseUrl}logo-hero.png`} width="160" height="160" alt="" />
      <h1>DeepSeek Harness插件市场</h1>
      <p class="home-hero__lead">从 GitHub 自动收录 DeepSeek Harness 插件，按使用场景分类浏览。</p>

      <label class="field home-search">
        <Search size={17} stroke-width={1.7} />
        <input
          id="catalog-search"
          type="search"
          placeholder="搜索插件、作者、描述或标签"
          autocomplete="off"
        />
      </label>

      <div class="home-hero__stats" aria-label="收录统计">
        <dl class="home-hero__stats-grid">
          <div class="home-stat">
            <dt><Boxes size={14} stroke-width={1.7} /> 已收录</dt>
            <dd>{catalog.stats.fetched}</dd>
          </div>
          <div class="home-stat">
            <dt><RefreshCw size={14} stroke-width={1.7} /> 数据更新</dt>
            <dd class="home-stat__time">{generatedDate}</dd>
          </div>
          <div class="home-stat">
            <dt><Star size={14} stroke-width={1.7} /> 精选</dt>
            <dd>{featuredCount}</dd>
          </div>
          <div class="home-stat">
            <dt><LayoutGrid size={14} stroke-width={1.7} /> 功能分类</dt>
            <dd>{CATEGORIES.length}</dd>
          </div>
        </dl>
        <div class="home-hero__actions">
          <a class="curated-hero-btn" href={`${baseUrl}curated`}>
            <Crown size={16} stroke-width={1.8} aria-hidden="true" />
            <span class="curated-hero-btn__label">站长精选</span>
          </a>
          <button class="curated-hero-btn curated-hero-btn--community" id="community-open-btn" type="button">
            <Send size={16} stroke-width={1.8} aria-hidden="true" />
            <span class="curated-hero-btn__label">社区发布</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="home-tools">
    <div class="container">
      <div class="home-tools__row">
        <div class="home-tools__selects">
          <label class="field select-field">
            <SlidersHorizontal size={14} stroke-width={1.7} />
            <span class="select-value" id="sort-filter-value">最新创建</span>
            <select id="sort-filter" aria-label="排序方式">
              <option value="created">最新创建</option>
              <option value="stars">最多 Star</option>
              <option value="updated">最近更新</option>
              <option value="name">名称排序</option>
            </select>
            <ChevronDown size={13} stroke-width={1.7} />
          </label>
          <label class="field select-field">
            <Layers size={14} stroke-width={1.7} />
            <span class="select-value" id="type-filter-value">全部类型</span>
            <select id="type-filter" aria-label="项目类型">
              <option value="all">全部类型</option>
              {PROJECT_TYPES.map((type) => (
                <option value={type.id}>{type.label} · {catalog.stats.projectTypes[type.id] ?? 0}</option>
              ))}
            </select>
            <ChevronDown size={13} stroke-width={1.7} />
          </label>
        </div>
        <div class="category-row" id="category-filter" aria-label="筛选">
          <button class="chip is-active" type="button" data-category="all">
            全部 <span class="chip__count">{catalog.stats.fetched}</span>
          </button>
          <button class="chip" type="button" data-category="favorites">
            <Bookmark size={12} stroke-width={1.8} />
            收藏 <span class="chip__count" id="favorite-count">0</span>
          </button>
          <button class="chip" type="button" data-category="curated">
            <Crown size={12} stroke-width={1.8} />
            站长精选 <span class="chip__count">{CURATED_PICKS.length}</span>
          </button>
          <button class="chip" type="button" data-category="featured">
            <i class="chip__dot chip__dot--featured"></i>
            精选 <span class="chip__count">{featuredCount}</span>
          </button>
          {CATEGORIES.map((category) => (
            <button class="chip" type="button" data-category={category.id}>
              <i class="chip__dot" style={`--category-color: ${category.color}`}></i>
              {category.label}
              <span class="chip__count">{catalog.stats.categories[category.id] ?? 0}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-results">
    <div class="container">
      <div class="results-head">
        <p><span id="result-count">{catalog.stats.fetched}</span> 个项目</p>
        <p class="results-head__note">自动同步 GitHub 数据</p>
      </div>

      <div class="project-grid" id="project-grid">
        {initialRepositories.map((repository) => <ProjectCard repository={repository} createdDisplay="relative" />)}
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <Search size={28} stroke-width={1.4} />
        <h2>没有找到匹配项目</h2>
        <p>换个关键词或清除筛选条件试试。</p>
        <button class="btn" id="clear-filters" type="button">清除筛选</button>
      </div>

      <div class="load-row">
        <button class="btn" id="load-more" type="button">
          加载更多
          <span id="remaining-count">{Math.max(0, catalog.stats.fetched - initialRepositories.length)}</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 社区发布：玻璃拟态弹窗，用户填写 GitHub 链接自动获取项目信息 -->
  <div class="community-modal" id="community-modal" hidden aria-hidden="true">
    <div class="community-modal__backdrop" data-community-close></div>
    <div class="community-modal__panel" role="dialog" aria-modal="true" aria-labelledby="community-modal-title">
      <button class="community-modal__close" type="button" data-community-close aria-label="关闭">
        <X size={18} stroke-width={1.8} />
      </button>

      <div class="community-modal__view" id="community-view-form">
        <div class="community-modal__head">
          <p class="mono-label">COMMUNITY PUBLISH</p>
          <h2 id="community-modal-title">发布你的 DSH 插件</h2>
          <p class="community-modal__sub">填写 GitHub 仓库链接，自动获取项目信息，收录到「社群发布」分类。</p>
        </div>

        <form id="community-form" novalidate>
          <div class="modal-field">
            <label for="community-repo-input">GitHub 仓库链接</label>
            <div class="field modal-repo-field">
              <Link2 size={16} stroke-width={1.7} />
              <input
                id="community-repo-input"
                type="text"
                placeholder="https://github.com/owner/repo 或 owner/repo"
                autocomplete="off"
                spellcheck="false"
              />
            </div>
            <p class="modal-field__hint" id="community-repo-hint">仅支持公开仓库，且必须是 DeepSeek Harness 插件。</p>
          </div>

          <div class="modal-field">
            <span class="modal-field__label">仓库信息预览</span>
            <div class="community-preview" id="community-preview" hidden>
              <div class="community-preview__state" id="community-preview-state">
                <span class="loader" aria-hidden="true"></span>
                正在从 GitHub 获取仓库信息…
              </div>
              <div class="community-preview__body" id="community-preview-body" hidden>
                <img id="community-preview-avatar" width="40" height="40" alt="" />
                <div class="community-preview__main">
                  <p class="community-preview__name"><span id="community-preview-name"></span><span class="badge badge--community">社群发布</span></p>
                  <p class="community-preview__fullname" id="community-preview-fullname"></p>
                  <p class="community-preview__desc" id="community-preview-desc"></p>
                  <p class="community-preview__meta" id="community-preview-meta"></p>
                  <div class="community-preview__topics" id="community-preview-topics"></div>
                </div>
              </div>
              <div class="community-preview__error" id="community-preview-error" hidden></div>
            </div>
          </div>

          <div class="modal-field">
            <span class="modal-field__label">验证码</span>
            <div class="captcha-row">
              <span class="captcha-question" id="captcha-question" aria-label="验证码题目"></span>
              <input
                id="captcha-input"
                type="text"
                inputmode="numeric"
                placeholder="结果"
                autocomplete="off"
                aria-label="验证码答案"
              />
              <button class="btn btn--icon" id="captcha-refresh" type="button" aria-label="换一道题" title="换一道题">
                <RefreshCw size={15} stroke-width={1.7} />
              </button>
            </div>
          </div>

          <input class="community-honeypot" id="community-honeypot" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <p class="community-form__status" id="community-form-status" role="status" aria-live="polite"></p>

          <div class="community-modal__actions">
            <button class="btn" type="button" data-community-close>取消</button>
            <button class="btn btn--primary" id="community-submit-btn" type="submit">
              <Send size={15} stroke-width={1.7} />
              提交发布
            </button>
          </div>
        </form>
      </div>

      <div class="community-modal__view" id="community-view-success" hidden>
        <div class="community-success">
          <span class="community-success__check">✓</span>
          <h2>提交成功</h2>
          <p>你的插件已进入「社群发布」队列，审核通过后会自动展示在首页与详情页。</p>
          <button class="btn btn--primary" type="button" data-community-close>完成</button>
        </div>
      </div>
    </div>
  </div>

  <script id="catalog-data" type="application/json" set:html={serializedCatalog} is:inline></script>
  <script id="category-data" type="application/json" set:html={serializedCategories} is:inline></script>
  <script id="type-data" type="application/json" set:html={serializedTypes} is:inline></script>
  <script id="curated-data" type="application/json" set:html={serializedCurated} is:inline></script>
  <script id="base-url" type="application/json" set:html={JSON.stringify(baseUrl)} is:inline></script>

  <script is:inline>
    const repositories = JSON.parse(document.getElementById('catalog-data').textContent)
    const categories = JSON.parse(document.getElementById('category-data').textContent)
    const projectTypes = JSON.parse(document.getElementById('type-data').textContent)
    const curatedNames = new Set(JSON.parse(document.getElementById('curated-data').textContent))
    const baseUrl = JSON.parse(document.getElementById('base-url').textContent)
    const categoryById = new Map(categories.map((category) => [category.id, category]))
    const typeById = new Map(projectTypes.map((type) => [type.id, type]))
    const grid = document.getElementById('project-grid')
    const sourceCard = grid.querySelector('[data-project-card]').cloneNode(true)
    const searchInput = document.getElementById('catalog-search')
    const typeFilter = document.getElementById('type-filter')
    const sortFilter = document.getElementById('sort-filter')
    const typeFilterValue = document.getElementById('type-filter-value')
    const sortFilterValue = document.getElementById('sort-filter-value')
    const categoryFilter = document.getElementById('category-filter')
    const resultCount = document.getElementById('result-count')
    const loadMore = document.getElementById('load-more')
    const remainingCount = document.getElementById('remaining-count')
    const emptyState = document.getElementById('empty-state')
    const clearFilters = document.getElementById('clear-filters')
    const favoriteCount = document.getElementById('favorite-count')
    const pageSize = 24

    // ---------- 收藏（localStorage） ----------
    const FAVORITES_KEY = 'dsh-market:favorites'
    const readFavorites = () => {
      try {
        const raw = localStorage.getItem(FAVORITES_KEY)
        return new Set(raw ? JSON.parse(raw) : [])
      } catch {
        return new Set()
      }
    }
    let favorites = readFavorites()
    const writeFavorites = () => {
      localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favorites]))
      favoriteCount.textContent = String(favorites.size)
    }

    const requestedCategory = new URLSearchParams(window.location.search).get('category')
    let selectedCategory = requestedCategory === 'featured'
      || requestedCategory === 'favorites'
      || requestedCategory === 'curated'
      || categoryById.has(requestedCategory)
      ? requestedCategory
      : 'all'
    let visibleCount = pageSize

    const compactNumber = (value) => {
      if (value < 1000) return String(value)
      if (value < 1000000) return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`
      return `${(value / 1000000).toFixed(1).replace(/\.0$/, '')}m`
    }

    // 创建日期，固定 Asia/Shanghai 时区，格式 YYYY-MM-DD
    const formatCreatedDate = (value) => {
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return '未知'
      const parts = new Intl.DateTimeFormat('zh-CN', {
        timeZone: 'Asia/Shanghai',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(date)
      const get = (type) => parts.find((part) => part.type === type)?.value ?? ''
      return `${get('year')}-${get('month')}-${get('day')}`
    }

    // 相对创建时间：只看创建时间，与更新时间无关（仅「最新创建」排序使用）
    const formatRelativeCreated = (value) => {
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return '未知'
      const elapsed = Date.now() - date.getTime()
      if (elapsed < 60_000) return '刚刚创建'
      if (elapsed < 3_600_000) return `${Math.floor(elapsed / 60_000)} 分钟前创建`
      if (elapsed < 86_400_000) return `${Math.floor(elapsed / 3_600_000)} 小时前创建`
      if (elapsed < 7 * 86_400_000) return `${Math.floor(elapsed / 86_400_000)} 天前创建`
      return formatCreatedDate(value)
    }

    const setText = (card, selector, value) => {
      const target = card.querySelector(selector)
      if (target) target.textContent = value
    }

    const createCard = (repository) => {
      const card = sourceCard.cloneNode(true)
      const category = categoryById.get(repository.category)
      const projectType = typeById.get(repository.projectType)
      const detailUrl = `${baseUrl}plugins/${repository.slug}`
      const searchable = [
        repository.name,
        repository.fullName,
        repository.description,
        repository.language || '',
        ...repository.topics,
      ].join(' ').toLocaleLowerCase('zh-CN')

      card.dataset.search = searchable
      card.dataset.category = repository.category
      card.dataset.type = repository.projectType
      card.dataset.stars = String(repository.stars)
      card.dataset.updated = repository.pushedAt
      card.dataset.created = repository.createdAt

      const categoryDot = card.querySelector('.project-card__category i')
      if (categoryDot) categoryDot.style.setProperty('--category-color', category.color)
      setText(card, '[data-field="category"]', category.label)
      setText(card, '[data-field="project-type"]', projectType.label)
      setText(card, '[data-field="owner"]', repository.owner.login)
      setText(card, '[data-field="description"]', repository.description)
      setText(card, '[data-field="stars"]', compactNumber(repository.stars))
      setText(card, '[data-field="created"]', sortFilter.value === 'created'
        ? formatRelativeCreated(repository.createdAt)
        : formatCreatedDate(repository.createdAt))

      const language = card.querySelector('[data-field="language"]')
      if (language) {
        language.textContent = repository.language || ''
        language.closest('.project-card__language').hidden = !repository.language
      }

      const detailLink = card.querySelector('[data-field="detail-link"]')
      detailLink.href = detailUrl
      detailLink.textContent = repository.name

      // 状态徽章：已归档 > 精选 互斥；官方 / 社群发布 独立
      const isCommunityEntry = repository.source === 'community' || repository.projectType === 'community'
      const statusKind = repository.archived
        ? 'archived'
        : repository.featured
          ? 'featured'
          : null
      card.querySelectorAll('[data-status-kind]').forEach((badge) => {
        badge.hidden = true
      })
      if (statusKind) {
        const statusBadge = card.querySelector(`[data-status-kind="${statusKind}"]`)
        if (statusBadge) statusBadge.hidden = false
      }
      // 官方标签：仅 DeepSeek Harness 本体
      const officialBadge = card.querySelector('[data-status-kind="official"]')
      if (officialBadge) officialBadge.hidden = repository.fullName.toLowerCase() !== 'deepseek-ai/deepseek-harness'
      // 社群发布徽章 + 隐藏重复的类型文字
      const communityBadge = card.querySelector('[data-source-kind="community"]')
      if (communityBadge) communityBadge.hidden = !isCommunityEntry
      const typeLabel = card.querySelector('[data-field="project-type"]')
      if (typeLabel) typeLabel.hidden = isCommunityEntry

      // 标签（最多 2 个，可点击跳转）
      const topicList = card.querySelector('[data-field="topics"]')
      if (topicList) {
        const topics = repository.topics.slice(0, 2)
        if (topics.length > 0) {
          const templateLink = topicList.querySelector('a')
          topicList.replaceChildren(...topics.map((topic) => {
            const link = templateLink.cloneNode(true)
            link.href = `${baseUrl}topics/${encodeURIComponent(topic)}`
            link.title = `查看 ${topic} 标签下的项目`
            const text = link.querySelector('[data-field="topic-text"]')
            if (text) text.textContent = topic
            return link
          }))
        } else {
          topicList.remove()
        }
      }

      // 收藏按钮
      const favButton = card.querySelector('[data-fav]')
      if (favButton) {
        const favId = String(repository.repositoryId)
        favButton.dataset.favId = favId
        favButton.setAttribute('aria-label', `收藏 ${repository.name}`)
        const isFav = favorites.has(favId)
        favButton.classList.toggle('is-active', isFav)
        favButton.setAttribute('aria-pressed', String(isFav))
        favButton.addEventListener('click', (event) => {
          event.preventDefault()
          event.stopPropagation()
          const active = !favorites.has(favId)
          if (active) {
            favorites.add(favId)
          } else {
            favorites.delete(favId)
          }
          writeFavorites()
          favButton.classList.toggle('is-active', active)
          favButton.setAttribute('aria-pressed', String(active))
          if (selectedCategory === 'favorites') render()
        })
      }

      return card
    }

    const getFilteredRepositories = () => {
      const query = searchInput.value.trim().toLocaleLowerCase('zh-CN')
      const selectedType = typeFilter.value
      return repositories.filter((repository) => {
        const searchable = [
          repository.name,
          repository.fullName,
          repository.description,
          repository.language || '',
          ...repository.topics,
        ].join(' ').toLocaleLowerCase('zh-CN')
        const matchesQuery = !query || searchable.includes(query)
        const matchesCategory = selectedCategory === 'all'
          || (selectedCategory === 'favorites'
            ? favorites.has(String(repository.repositoryId))
            : selectedCategory === 'curated'
              ? curatedNames.has(repository.fullName)
              : selectedCategory === 'featured'
                ? repository.featured
                : repository.category === selectedCategory)
        const matchesType = selectedType === 'all' || repository.projectType === selectedType
        return matchesQuery && matchesCategory && matchesType
      })
    }

    const compareStatus = (left, right) => {
      const featuredPriority = Number(right.featured) - Number(left.featured)
      return featuredPriority
    }
    const compareStars = (left, right) => (
      right.stars - left.stars
      || compareStatus(left, right)
      || left.fullName.localeCompare(right.fullName)
    )

    const sortRepositories = (filtered) => {
      const sort = sortFilter.value
      if (sort === 'created') {
        return filtered.sort((left, right) => (
          Date.parse(right.createdAt) - Date.parse(left.createdAt)
          || compareStatus(left, right)
          || left.fullName.localeCompare(right.fullName)
        ))
      }
      if (sort === 'updated') {
        return filtered.sort((left, right) => (
          Date.parse(right.pushedAt) - Date.parse(left.pushedAt)
          || compareStatus(left, right)
          || left.fullName.localeCompare(right.fullName)
        ))
      }
      if (sort === 'name') {
        return filtered.sort((left, right) => (
          left.name.localeCompare(right.name)
          || compareStatus(left, right)
          || left.fullName.localeCompare(right.fullName)
        ))
      }
      return filtered.sort(compareStars)
    }

    const render = () => {
      const filtered = sortRepositories(getFilteredRepositories())
      const visible = filtered.slice(0, visibleCount)
      grid.replaceChildren(...visible.map(createCard))
      resultCount.textContent = String(filtered.length)
      emptyState.hidden = filtered.length !== 0
      grid.hidden = filtered.length === 0
      const remaining = Math.max(0, filtered.length - visible.length)
      loadMore.hidden = remaining === 0
      remainingCount.textContent = String(remaining)
    }

    const resetAndRender = () => {
      visibleCount = pageSize
      render()
    }

    const syncSelectValue = (select, target) => {
      target.textContent = select.selectedOptions[0]?.textContent ?? ''
    }

    const setCategory = (category) => {
      selectedCategory = category
      categoryFilter.querySelectorAll('[data-category]').forEach((item) => {
        item.classList.toggle('is-active', item.dataset.category === category)
      })
      resetAndRender()
    }

    searchInput.addEventListener('input', resetAndRender)
    typeFilter.addEventListener('change', () => {
      syncSelectValue(typeFilter, typeFilterValue)
      resetAndRender()
    })
    sortFilter.addEventListener('change', () => {
      syncSelectValue(sortFilter, sortFilterValue)
      resetAndRender()
    })
    categoryFilter.addEventListener('click', (event) => {
      const button = event.target.closest('[data-category]')
      if (!button) return
      setCategory(button.dataset.category)
    })
    loadMore.addEventListener('click', () => {
      visibleCount += pageSize
      render()
    })
    clearFilters.addEventListener('click', () => {
      searchInput.value = ''
      typeFilter.value = 'all'
      sortFilter.value = 'created'
      syncSelectValue(typeFilter, typeFilterValue)
      syncSelectValue(sortFilter, sortFilterValue)
      setCategory('all')
      searchInput.focus()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== searchInput) {
        event.preventDefault()
        searchInput.focus()
      }
      if (event.key === 'Escape' && document.activeElement === searchInput) {
        searchInput.value = ''
        searchInput.blur()
        resetAndRender()
      }
    })
    if (selectedCategory !== 'all') {
      categoryFilter.querySelectorAll('[data-category]').forEach((item) => {
        item.classList.toggle('is-active', item.dataset.category === selectedCategory)
      })
    }
    // 首屏也按当前筛选/排序重新渲染，保证「几分钟前创建」等相对时间是实时的
    resetAndRender()

    // ---------- 社区发布弹窗 ----------
    const communityModal = document.getElementById('community-modal')
    const communityOpenBtn = document.getElementById('community-open-btn')
    const communityForm = document.getElementById('community-form')
    const communityRepoInput = document.getElementById('community-repo-input')
    const communityRepoHint = document.getElementById('community-repo-hint')
    const communityPreview = document.getElementById('community-preview')
    const communityPreviewState = document.getElementById('community-preview-state')
    const communityPreviewBody = document.getElementById('community-preview-body')
    const communityPreviewError = document.getElementById('community-preview-error')
    const captchaQuestion = document.getElementById('captcha-question')
    const captchaInput = document.getElementById('captcha-input')
    const captchaRefresh = document.getElementById('captcha-refresh')
    const communityFormStatus = document.getElementById('community-form-status')
    const communitySubmitBtn = document.getElementById('community-submit-btn')
    const communityHoneypot = document.getElementById('community-honeypot')
    const communityViewForm = document.getElementById('community-view-form')
    const communityViewSuccess = document.getElementById('community-view-success')
    let captchaAnswer = 0
    let fetchedRepo = null
    let fetchingRepo = false

    const parseFullName = (value) => {
      const trimmed = String(value || '').trim()
        .replace(/^https?:\/\/(www\.)?github\.com\//i, '')
        .replace(/^git@github\.com:/i, '')
        .replace(/\.git$/i, '')
        .replace(/\/+$/, '')
      const match = trimmed.match(/^([A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)\/([A-Za-z0-9_.-]+)$/)
      return match ? `${match[1]}/${match[2]}` : null
    }

    const newCaptcha = () => {
      const left = 1 + Math.floor(Math.random() * 9)
      const right = 1 + Math.floor(Math.random() * 9)
      captchaAnswer = left + right
      captchaQuestion.textContent = `${left} + ${right} = ?`
      captchaInput.value = ''
    }

    const setFormStatus = (message, kind = 'error') => {
      communityFormStatus.textContent = message
      communityFormStatus.dataset.kind = kind
    }

    const formatFullCreated = (value) => {
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return '未知'
      const parts = new Intl.DateTimeFormat('zh-CN', {
        timeZone: 'Asia/Shanghai',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(date)
      const get = (type) => parts.find((part) => part.type === type)?.value ?? ''
      return `${get('year')}-${get('month')}-${get('day')}`
    }

    const fetchRepoInfo = async (fullName) => {
      const response = await fetch(`https://api.github.com/repos/${encodeURIComponent(fullName)}`, {
        headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'dsh-plugin-store' },
      })
      if (response.status === 404) throw new Error('GitHub 上找不到该仓库，请检查链接是否正确。')
      if (response.status === 403 || response.status === 429) {
        throw new Error('GitHub API 请求太频繁，请稍等片刻再试。')
      }
      if (!response.ok) throw new Error(`GitHub API 请求失败（${response.status}）。`)
      return response.json()
    }

    const renderRepoPreview = (repo) => {
      document.getElementById('community-preview-avatar').src = repo.owner?.avatar_url ?? ''
      document.getElementById('community-preview-avatar').alt = repo.owner?.login ?? ''
      document.getElementById('community-preview-name').textContent = repo.name
      document.getElementById('community-preview-fullname').textContent = repo.full_name
      document.getElementById('community-preview-desc').textContent = repo.description || '该仓库暂未提供项目说明。'
      const meta = [
        `Star ${compactNumber(repo.stargazers_count ?? 0)}`,
        repo.language,
        `创建于 ${formatFullCreated(repo.created_at)}`,
      ].filter(Boolean).join(' · ')
      document.getElementById('community-preview-meta').textContent = meta
      const topicsEl = document.getElementById('community-preview-topics')
      topicsEl.replaceChildren(...(repo.topics ?? []).slice(0, 4).map((topic) => {
        const span = document.createElement('span')
        span.className = 'community-preview__topic'
        span.textContent = topic
        return span
      }))
      communityPreviewState.hidden = true
      communityPreviewError.hidden = true
      communityPreviewBody.hidden = false
    }

    const autoFetchRepo = async () => {
      if (fetchingRepo) return
      const fullName = parseFullName(communityRepoInput.value)
      if (!fullName) {
        communityPreview.hidden = true
        communityPreviewBody.hidden = true
        communityPreviewError.hidden = true
        return
      }
      fetchingRepo = true
      communityPreview.hidden = false
      communityPreviewBody.hidden = true
      communityPreviewError.hidden = true
      communityPreviewState.hidden = false
      communityPreviewState.innerHTML = '<span class="loader" aria-hidden="true"></span> 正在从 GitHub 获取仓库信息…'
      try {
        const repo = await fetchRepoInfo(fullName)
        fetchedRepo = repo
        renderRepoPreview(repo)
        communityRepoHint.textContent = `已获取 ${repo.full_name}，确认无误后提交。`
        communityRepoHint.classList.add('is-ok')
        setFormStatus('', 'ok')
      } catch (error) {
        fetchedRepo = null
        communityPreviewState.hidden = true
        communityPreviewBody.hidden = true
        communityPreviewError.hidden = false
        communityPreviewError.textContent = error instanceof Error ? error.message : '获取仓库信息失败，请稍后重试。'
        communityRepoHint.textContent = '仅支持公开仓库，且必须是 DeepSeek Harness 插件。'
        communityRepoHint.classList.remove('is-ok')
      } finally {
        fetchingRepo = false
      }
    }

    const openCommunityModal = () => {
      communityModal.hidden = false
      communityModal.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
      communityViewForm.hidden = false
      communityViewSuccess.hidden = true
      communityForm.reset()
      communityPreview.hidden = true
      communityPreviewBody.hidden = true
      communityPreviewError.hidden = true
      communityPreviewState.hidden = true
      communityRepoHint.textContent = '仅支持公开仓库，且必须是 DeepSeek Harness 插件。'
      communityRepoHint.classList.remove('is-ok')
      fetchedRepo = null
      setFormStatus('', 'ok')
      newCaptcha()
      setTimeout(() => communityRepoInput.focus(), 60)
    }

    const closeCommunityModal = () => {
      communityModal.hidden = true
      communityModal.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    const showCommunitySuccess = () => {
      communityViewForm.hidden = true
      communityViewSuccess.hidden = false
    }

    communityOpenBtn?.addEventListener('click', openCommunityModal)
    communityModal.querySelectorAll('[data-community-close]').forEach((element) => {
      element.addEventListener('click', closeCommunityModal)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !communityModal.hidden) closeCommunityModal()
    })
    captchaRefresh?.addEventListener('click', () => {
      newCaptcha()
      captchaInput.focus()
    })
    communityRepoInput.addEventListener('blur', autoFetchRepo)
    communityRepoInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault()
        autoFetchRepo()
      }
    })

    communityForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (communityHoneypot.value) {
        showCommunitySuccess()
        return
      }
      const fullName = parseFullName(communityRepoInput.value)
      if (!fullName) {
        setFormStatus('请填写有效的 GitHub 仓库链接。')
        communityRepoInput.focus()
        return
      }
      if (!fetchedRepo) {
        setFormStatus('请先等待仓库信息获取成功后再提交。')
        return
      }
      const answer = Number(captchaInput.value.trim())
      if (Number.isNaN(answer) || answer !== captchaAnswer) {
        setFormStatus('验证码不正确，请重新输入。')
        newCaptcha()
        captchaInput.focus()
        return
      }
      communitySubmitBtn.disabled = true
      setFormStatus('正在提交…', 'ok')
      try {
        const response = await fetch('/api/community/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName,
            url: fetchedRepo.html_url || `https://github.com/${fullName}`,
          }),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) {
          throw new Error(data.error || `提交失败（${response.status}）。`)
        }
        showCommunitySuccess()
      } catch (error) {
        setFormStatus(error instanceof Error ? error.message : '提交失败，请稍后重试。')
      } finally {
        communitySubmitBtn.disabled = false
      }
    })

    favoriteCount.textContent = String(favorites.size)
  </script>
</BaseLayout>

